<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.PopcornTickets">
        <activity
            android:name=".DataObjects.Ticket"
            android:exported="false" />
        <activity
            android:name=".Booking.ConfirmPage"
            android:exported="false" />
        <activity
            android:name=".Booking.BookSeat"
            android:exported="false" />
        <activity
            android:name=".Booking.MovieScreen"
            android:exported="false" />
        <activity
            android:name=".Booking.Homescreen"
            android:exported="false"
            android:label="@string/title_activity_homescreen" />
        <activity
            android:name=".Adapters.SignupActivity"
            android:exported="false" />
        <activity
            android:name=".Auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Booking.MainActivity"
            android:exported="true" />
    </application>

</manifest>