<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Booking.BookSeat"
    android:background="@color/black">

    <LinearLayout
        android:id="@+id/date_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/date1"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:background="@drawable/btn_selected"
            android:fontFamily="@font/natasansbold"
            android:gravity="center"
            android:padding="10dp"
            android:text="22-8-25"
            android:textColor="@color/blackish"
            android:textSize="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/date2"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_back"
            android:fontFamily="@font/natasansbold"
            android:gravity="center"
            android:padding="10dp"
            android:text="23/8/25"
            android:textColor="@color/blackish"
            android:textSize="15dp"
            app:layout_constraintStart_toEndOf="@+id/date1"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/date3"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:background="@drawable/btn_back"
            android:fontFamily="@font/natasansbold"
            android:gravity="center"
            android:padding="10dp"
            android:text="24/8/25"
            android:textColor="@color/blackish"
            android:textSize="15dp"
            app:layout_constraintStart_toEndOf="@+id/date2"
            app:layout_constraintTop_toTopOf="parent" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/time_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/date_selector">

        <TextView
            android:id="@+id/time1"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:background="@drawable/btn_selected"
            android:fontFamily="@font/natasansbold"
            android:gravity="center"
            android:padding="10dp"
            android:text="11AM"
            android:textColor="@color/blackish"
            android:textSize="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/time2"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_back"
            android:fontFamily="@font/natasansbold"
            android:gravity="center"
            android:padding="10dp"
            android:text="4 PM"
            android:textColor="@color/blackish"
            android:textSize="15dp"
            app:layout_constraintStart_toEndOf="@+id/date1"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/time3"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_margin="10dp"
            android:background="@drawable/btn_back"
            android:fontFamily="@font/natasansbold"
            android:gravity="center"
            android:padding="10dp"
            android:text="8 PM"
            android:textColor="@color/blackish"
            android:textSize="15dp"
            app:layout_constraintStart_toEndOf="@+id/date2"
            app:layout_constraintTop_toTopOf="parent" />

    </LinearLayout>


    <GridView
        android:padding="10dp"
        android:id="@+id/gridViewSeats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:horizontalSpacing="8dp"
        android:numColumns="5"
        android:verticalSpacing="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_selector" />


    <TextView
        android:id="@+id/textView5"
        android:layout_width="420dp"
        android:layout_height="30dp"
        android:layout_gravity="center"
        android:layout_margin="10dp"
        android:background="#E91E63"
        android:fontFamily="@font/natasansbold"
        android:gravity="center"
        android:text="Screen This Way"
        android:textColor="@color/blackish"
        android:textSize="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gridViewSeats" />

    <TextView
        android:id="@+id/bookBtn"
        android:layout_width="350dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:layout_margin="20dp"
        android:background="@drawable/btn_back"
        android:fontFamily="@font/natasansbold"
        android:gravity="center"
        android:padding="10dp"
        android:text="Book Selected Seats"
        android:textColor="@color/blackish"
        android:textSize="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5" />




</androidx.constraintlayout.widget.ConstraintLayout>